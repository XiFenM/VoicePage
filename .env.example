# ZenMux API Key（https://zenmux.ai 控制台获取）
ZENMUX_API_KEY=sk-...

# 可选：ZenMux 接口地址
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# ZENMUX_VERTEX_BASE_URL=https://zenmux.ai/api/vertex-ai

# 生成口述稿使用的 LLM（ZenMux 模型 slug）
SCRIPT_MODEL=openai/gpt-4.1-mini

# 单用户登录密码
APP_PASSWORD=change-me
# Session 签名密钥，用 `openssl rand -base64 32` 生成
SESSION_SECRET=
