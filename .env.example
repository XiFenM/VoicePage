# ZenMux API Key（https://zenmux.ai 控制台获取）
ZENMUX_API_KEY=sk-...

# 可选：ZenMux 接口地址
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1

# 生成口述稿使用的 LLM（ZenMux 模型 slug，需支持 response_format=json_schema）
SCRIPT_MODEL=google/gemini-2.5-flash

# 单用户登录密码
APP_PASSWORD=change-me
# Session 签名密钥，用 `openssl rand -base64 32` 生成
SESSION_SECRET=
# 可选：数据目录（默认 ./data）
# DATA_DIR=/var/lib/readaloud
